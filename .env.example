# CodeYaar (AI chatbot) — optional. Without either key set, CodeYaar still
# works using a local mock reply engine (lib/codeyaar.ts); the app never
# breaks or fails to build without these.

# Recommended: Groq (fast + free tier) — https://console.groq.com
GROQ_API_KEY=

# Alternative: OpenAI (uses gpt-4o-mini) — used only if GROQ_API_KEY is unset
OPENAI_API_KEY=

# Used by app/sitemap.ts, app/robots.ts and app/layout.tsx metadata to build
# absolute URLs. Set this to your real deployed domain on Vercel.
NEXT_PUBLIC_SITE_URL=https://codeduniya.vercel.app
